<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Payment\Model\MethodList">
        <arguments>
            <argument name="paymentMethodGroups" xsi:type="array">
                <item name="budpaypayment" xsi:type="string">Budpay</item>
            </argument>
        </arguments>
    </type>

    <!-- Validator Pool Configuration -->
    <virtualType name="BudpayPaymentValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <!-- Add validators here when needed -->
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="BudpayPaymentCommandManager" type="Magento\Payment\Gateway\Command\CommandManager">
        <arguments>
            <argument name="commandPool" xsi:type="object">BudpayPaymentCommandPool</argument>
        </arguments>
    </virtualType>

    <!-- Command Pool Configuration (Choose ONE approach - this is recommended) -->
    <virtualType name="BudpayPaymentCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="initialize" xsi:type="string">Budpay\Payment\Gateway\Command\InitializeCommand</item>
                <item name="verify" xsi:type="string">Budpay\Payment\Gateway\Command\VerifyCommand</item>
                <item name="capture" xsi:type="string">\Magento\Payment\Gateway\Command\NullCommand</item>
                <item name="authorize" xsi:type="string">\Magento\Payment\Gateway\Command\NullCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Payment Adapter Configuration -->
    <type name="Budpay\Payment\Model\Payment\BudpayAdapter">
        <arguments>
            <argument name="eventManager" xsi:type="object">Magento\Framework\Event\Manager</argument>
            <argument name="valueHandlerPool" xsi:type="object">BudpayPaymentValueHandlerPool</argument>
            <argument name="paymentDataObjectFactory" xsi:type="object">Magento\Payment\Gateway\Data\PaymentDataObjectFactory</argument>
            <argument name="code" xsi:type="const">Budpay\Payment\Model\Payment\BudpayAdapter::CODE</argument>
            <argument name="formBlockType" xsi:type="string">Budpay\Payment\Block\Form\Budpay</argument>
            <argument name="infoBlockType" xsi:type="string">Budpay\Payment\Block\Info\Budpay</argument>

            <!-- Use Command Pool (recommended) -->
            <argument name="commandPool" xsi:type="object">BudpayPaymentCommandPool</argument>
            <argument name="commandExecutor" xsi:type="object">BudpayPaymentCommandManager</argument>

            <argument name="validatorPool" xsi:type="object">BudpayPaymentValidatorPool</argument>
            <argument name="logger" xsi:type="object">Magento\Framework\Logger\Monolog</argument>
        </arguments>
    </type>

    <!-- Value Handler Configuration -->
    <virtualType name="BudpayPaymentValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">BudpayPaymentConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="BudpayPaymentConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">BudpayPaymentConfig</argument>
        </arguments>
    </virtualType>

    <virtualType name="BudpayPaymentConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Budpay\Payment\Model\Payment\BudpayAdapter::CODE</argument>
        </arguments>
    </virtualType>
</config>
